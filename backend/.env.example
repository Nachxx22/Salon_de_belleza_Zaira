# Copia este archivo como backend/.env y completa tus valores locales.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# --- Servidor ---------------------------------------------------------------
PUERTO=3000
NODE_ENV=development
# Clave para firmar la cookie de sesión. Pon una frase larga y distinta en cada computadora.
SESSION_SECRET=cambia-esta-frase-por-una-larga-y-secreta

# --- SQL Server ---------------------------------------------------------------
DB_SERVER=localhost
# Puerto TCP fijo de la instancia (recomendado). Si lo dejas vacío y usas
# DB_INSTANCE, el servicio SQL Server Browser debe estar encendido.
DB_PORT=1433
DB_INSTANCE=
# ZairaDev_A en la computadora de A, ZairaDev_B en la de B,
# ZairaIntegracion para integrar y para la demostración.
DB_NAME=ZairaDev_B
# Login SQL de desarrollo que ya usan (el mismo de Base de Datos 1).
# Usuario y contraseña se escriben solo en tu .env local; nunca en GitHub.
DB_USER=
DB_PASSWORD=
# En local se usa el certificado propio de SQL Server.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# --- Cuenta de la administradora (solo la usa `npm run db:admin`) ------------
ADMIN_USUARIO=admin
ADMIN_CONTRASENA=
